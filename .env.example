# Copy to .env and fill in. .env is git-ignored: never commit it, never paste values into chat.
# Quote any value that contains shell characters (# ? < } $ & space) with single quotes.

# --- Boomi platform (Boomi Companion reads these) ---
BOOMI_API_URL=https://api.boomi.com
# your Boomi login email
BOOMI_USERNAME=
# AtomSphere API token (Settings > AtomSphere API Tokens)
BOOMI_API_TOKEN=
BOOMI_ACCOUNT_ID=
BOOMI_VERIFY_SSL=true
# id of the environment your Atom is attached to
BOOMI_ENVIRONMENT_ID=
# id of that Atom
BOOMI_TEST_ATOM_ID=
# id of the folder "Sku Harmonization POC" (create it first)
BOOMI_TARGET_FOLDER=

# --- Boomi Data Hub repository (hub Configure screen; NOT the Boomi API token) ---
# for example https://c01-usa-east.hub.boomi.com
DATAHUB_REPO_URI=
# <account-id>.<repo-token-id>
DATAHUB_REPO_USERNAME=
DATAHUB_REPO_AUTH_TOKEN=

# --- Shopify development store (Dev Dashboard app, client-credentials grant) ---
# your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# --- Local Postgres container (development and tests only) ---
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5442
POSTGRES_DB=harmonization
POSTGRES_USER=harm
# choose a password; the container is created with it
POSTGRES_PASSWORD=

# --- Warehouse the demo uses: a cloud Postgres, OR the local container above ---
# WAREHOUSE=rds uses the RDS_* keys (default). WAREHOUSE=local uses the POSTGRES_* keys above.
WAREHOUSE=rds
# jdbc:postgresql://<host>:5432/<database>
RDS_POSTGRES_JDBC_URL=
RDS_POSTGRES_USERNAME=
RDS_POSTGRES_PASSWORD=

# --- Boomi API Management key that Muse sends in the x-api-key header ---
HARM_MUSE_API_KEY=

# --- Optional: direct (Basic auth) access to the Atom's web server, for debugging ---
SERVER_BASE_URL=
SERVER_USERNAME=
SERVER_TOKEN=
SERVER_VERIFY_SSL=false
