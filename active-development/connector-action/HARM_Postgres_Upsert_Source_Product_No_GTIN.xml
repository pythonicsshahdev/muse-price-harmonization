  <bns:description>For listings with no GTIN. Binds positionally: HARM - Source Product Upsert (No GTIN) Request must stay in this order (source, source_key, name, price). Clears gtin on conflict. | built with boomi-companion v1.0.107</bns:description>
  <bns:object>
    <Operation returnApplicationErrors="false" trackResponse="false">
      <Archiving directory="" enabled="false"/>
      <Configuration>
        <GenericOperationConfig customOperationType="CREATE"
                                objectTypeId="harm_source_products"
                                objectTypeName="harm_source_products"
                                operationType="CREATE"
                                requestProfile="8d37e179-d606-4aef-8d22-72a53b7c916b"
                                requestProfileType="json"
                                responseProfile="0eda0deb-e07b-40a3-b385-e9ea1f3eabe9"
                                responseProfileType="json">
          <field id="InsertionType" type="string" value="Standard Insert"/>
          <field id="schemaName" type="string" value=""/>
          <field id="query" type="string" value="insert into public.harm_source_products (source, source_key, name, price, loaded_at) values (?, ?, ?, ?, now()) on conflict (source, source_key) do update set gtin = null, name = excluded.name, price = excluded.price, loaded_at = now()"/>
